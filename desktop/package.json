{
  "name": "dispatch-desktop",
  "productName": "Dispatch",
  "version": "0.4.10-alpha",
  "description": "Desktop app for a Dispatch server",
  "private": true,
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "pack": "electron-builder --dir",
    "build:audio": "node build-audio.js",
    "predist": "npm run build:audio",
    "prepack": "npm run build:audio"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "dev.dispatch.desktop",
    "productName": "Dispatch",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "picker-preload.js",
      "renderer/**",
      "build/icon.png",
      "package.json",
      "build/app-audio.exe"
    ],
    "asarUnpack": [
      "build/app-audio.exe"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Dispatch-Setup-${version}.${ext}"
    },
    "protocols": [
      {
        "name": "Dispatch",
        "schemes": [
          "dispatch"
        ]
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "http://localhost/replaced-at-runtime"
      }
    ],
    "portable": {
      "artifactName": "Dispatch-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}