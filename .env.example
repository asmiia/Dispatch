# Dispatch configuration. Copy to .env.local, or run `npm run setup` to generate it.

# One-time key that protects first-run setup (creating the administrator).
# It is not an API credential. 32+ random characters.
DISPATCH_SETUP_KEY=replace-with-a-random-key-at-least-32-characters

# Where the SQLite database and uploaded files are stored.
DISPATCH_DATA_DIR=.local

# --- Behind HTTPS (required when publishing) ---
# Public origin that browsers use to reach Dispatch. Also required for emailed links
# and OAuth sign-in (they are never built from the Host header).
# DISPATCH_ORIGIN=https://dispatch.example.com
# Mark the session cookie Secure.
# DISPATCH_COOKIE_SECURE=true

# --- Email (optional): invitations and password-reset links ---
# Without this, Dispatch shows invitation codes and reset links in the UI instead.
# DISPATCH_SMTP_URL=smtps://user:password@smtp.example.com:465
# DISPATCH_MAIL_FROM="Dispatch <no-reply@example.com>"

# --- Sign in with GitHub / Google (optional) ---
# Callback URL to register with the provider:
#   <DISPATCH_ORIGIN>/api/auth/oauth/github/callback   (or .../google/callback)
# Only existing accounts and invited emails can sign in this way.
# DISPATCH_GITHUB_CLIENT_ID=
# DISPATCH_GITHUB_CLIENT_SECRET=
# DISPATCH_GOOGLE_CLIENT_ID=
# DISPATCH_GOOGLE_CLIENT_SECRET=

# --- Operations ---
# debug | info | warn | error. Logs are JSON, one object per line.
# DISPATCH_LOG_LEVEL=info
# Set to true only behind a reverse proxy you control, so sign-in logs record the
# client IP from X-Forwarded-For.
# DISPATCH_TRUST_PROXY=true

# --- Backups ---
# Automatic backups run inside the app: a consistent database snapshot plus new attachments.
# Hours between backups; 0 turns them off.
# DISPATCH_BACKUP_INTERVAL_HOURS=24
# How many snapshots to keep.
# DISPATCH_BACKUP_KEEP=14
# Where backups go (default: <data dir>/backups). Use a different disk.
# DISPATCH_BACKUP_DIR=/mnt/backup/dispatch
# Seals the two-factor key inside each backup. Without it the key is stored in the clear.
# Keep this passphrase somewhere safe: you need it to restore.
# DISPATCH_BACKUP_PASSPHRASE=
