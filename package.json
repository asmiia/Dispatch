{
  "name": "dispatch",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3080",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3080",
    "test": "node --test tests/*.test.mjs",
    "setup": "node scripts/setup.mjs",
    "test:browser": "node tests/browser.mjs",
    "format": "prettier --write app lib tests scripts *.mjs *.json",
    "backup": "node scripts/backup.mjs backup",
    "backup:list": "node scripts/backup.mjs list",
    "backup:verify": "node scripts/backup.mjs verify",
    "restore": "node scripts/backup.mjs restore",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@radix-ui/react-select": "^2.4.1",
    "geist": "^1.8.2",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "nodemailer": "^10.3.1",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "prettier": "^3.9.10"
  }
}
