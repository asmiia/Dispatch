{
  "name": "dispatch",
  "version": "0.4.0-alpha",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3080",
    "prebuild": "node scripts/copy-ort.mjs",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3080",
    "test": "node --test tests/*.test.mjs",
    "setup": "node scripts/setup.mjs",
    "test:browser": "node tests/browser.mjs",
    "format": "prettier --write app lib tests scripts *.mjs *.json",
    "backup": "node scripts/backup.mjs backup",
    "backup:list": "node scripts/backup.mjs list",
    "backup:verify": "node scripts/backup.mjs verify",
    "restore": "node scripts/backup.mjs restore",
    "screenshots": "node scripts/screenshots.mjs",
    "demo": "node scripts/demo.mjs",
    "social": "node scripts/social.mjs",
    "format:check": "prettier --check app lib tests scripts *.mjs *.json",
    "test:call": "node tests/call.mjs",
    "test:ui": "node tests/ui-check.mjs",
    "test:desktop": "node desktop/smoke.mjs",
    "desktop": "npm --prefix desktop start",
    "desktop:build": "npm --prefix desktop run dist"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@daypicker/react": "~10.0.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@huggingface/transformers": "^4.3.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@radix-ui/react-select": "^2.4.1",
    "@untitledui/icons": "^0.0.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.9.0",
    "lucide-react": "^0.468.0",
    "motion": "^14.9.0",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "node-emoji": "^2.2.0",
    "nodemailer": "^10.3.1",
    "pdfjs-dist": "^6.5.438",
    "phonemizer": "^1.2.1",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-emoji": "^5.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "gifenc": "^1.0.3",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
